# ---------------------------------------------------------------------------
# Obseil - environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
OBSEIL_ENV=development                 # development | test | production
OBSEIL_DEBUG=true
OBSEIL_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
OBSEIL_LOG_FORMAT=console              # console | json

# --- Security --------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
OBSEIL_SECRET_KEY=change-me-in-production-use-a-long-random-value
OBSEIL_ACCESS_TOKEN_EXPIRE_MINUTES=30
OBSEIL_REFRESH_TOKEN_EXPIRE_DAYS=14
OBSEIL_PASSWORD_HASH_ROUNDS=12          # bcrypt cost; production refuses below 12

# Login rate limiting. Counted per client address and only on failures, so a
# successful sign-in never counts against anyone. Raise the limit if your users
# share one outbound address (an office NAT), since they share the counter.
OBSEIL_LOGIN_RATE_LIMIT_ENABLED=true
OBSEIL_LOGIN_MAX_ATTEMPTS=10
OBSEIL_LOGIN_ATTEMPT_WINDOW_SECONDS=300

# --- Sign in with Google / GitHub ------------------------------------------
# Optional. A provider with no credentials is not offered in the UI at all, so
# leaving these blank simply means password sign-in only.
#
# These two must match what you register with the provider, and must be the
# addresses a browser can reach - not container hostnames.
OBSEIL_API_BASE_URL=http://localhost:8000
OBSEIL_FRONTEND_BASE_URL=http://localhost:5173
#
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
#          -> Create OAuth client ID -> Web application
#          Authorised redirect URI:
#            http://localhost:8000/api/v1/auth/oauth/google/callback
OBSEIL_OAUTH_GOOGLE_CLIENT_ID=
OBSEIL_OAUTH_GOOGLE_CLIENT_SECRET=
#
# GitHub:  Settings -> Developer settings -> OAuth Apps -> New OAuth App
#          Authorization callback URL:
#            http://localhost:8000/api/v1/auth/oauth/github/callback
OBSEIL_OAUTH_GITHUB_CLIENT_ID=
OBSEIL_OAUTH_GITHUB_CLIENT_SECRET=

# --- Database --------------------------------------------------------------
POSTGRES_USER=obseil
POSTGRES_PASSWORD=obseil
POSTGRES_DB=obseil
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL wins over the discrete values above when set.
OBSEIL_DATABASE_URL=postgresql+psycopg://obseil:obseil@localhost:5432/obseil

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
OBSEIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads & storage -----------------------------------------------------
OBSEIL_STORAGE_BACKEND=local           # local (S3 planned)
OBSEIL_STORAGE_PATH=./var/datasets
OBSEIL_MAX_UPLOAD_BYTES=52428800       # 50 MiB
OBSEIL_MAX_ANALYSIS_ROWS=1000000       # hard ceiling before a dataset is rejected
OBSEIL_PROFILE_SAMPLE_ROWS=50000       # above this, analysis runs on a head sample

# --- Machine learning ------------------------------------------------------
OBSEIL_ANOMALY_CONTAMINATION=auto      # "auto" or a float in (0, 0.5]
OBSEIL_ANOMALY_RANDOM_STATE=42
OBSEIL_ANOMALY_MAX_ANOMALIES_STORED=500

# --- Frontend (build-time, read by Vite) -----------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
